# Copy this file to ".env" in the backend/ folder. It is loaded automatically at startup.
# Real environment variables win over values here. Never commit .env (it is git-ignored).

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_TIMEOUT=300
OLLAMA_NUM_CTX=8192
OLLAMA_THINK=false

# --- Summaries ---
SUMMARY_WINDOW_HOURS=12
GMAIL_WINDOW_MAX_EMAILS=25
GMAIL_EXCLUDE_NOISE=true
EMAIL_MAX_CHARS=1200
CHUNK_MAX_CHARS=4000

# --- API ---
# Keep API_HOST on 127.0.0.1 when you use "tailscale serve" (recommended).
API_HOST=127.0.0.1
API_PORT=8000
# The phone app must send this as "Authorization: Bearer <token>". Pick a long random string.
API_TOKEN=
